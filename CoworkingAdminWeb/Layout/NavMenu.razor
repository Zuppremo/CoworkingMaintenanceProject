<div class="fm-brand">
    <a class="fm-brand-link" href="">
        <span class="fm-brand-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#14B8A6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                <rect x="3" y="14" width="7" height="7" rx="1.5" />
                <path d="M14 17.5h7M17.5 14v7" />
            </svg>
        </span>
        <div>
            <div class="fm-brand-title">URBAN 165</div>
            <div class="fm-brand-sub">Facility Ops</div>
        </div>
    </a>
    <button title="Menú de navegación" class="fm-mobile-toggle" @onclick="ToggleNavMenu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
</div>

<div class="@NavMenuCssClass fm-nav-wrap" @onclick="ToggleNavMenu">
    <nav class="fm-nav">
        <div class="fm-nav-section">OPERACIONES &amp; ANALÍTICA</div>

        <AuthorizeView Roles="SuperAdmin,Admin">
            <NavLink class="fm-nav-link" href="dashboard" Match="NavLinkMatch.All">
                <svg class="fm-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18" />
                    <rect x="7" y="10" width="3" height="7" rx="0.5" />
                    <rect x="12" y="6" width="3" height="11" rx="0.5" />
                    <rect x="17" y="13" width="3" height="4" rx="0.5" />
                </svg>
                <span>Dashboard Resueltos</span>
            </NavLink>
        </AuthorizeView>

        <div class="fm-nav-section">INFRAESTRUCTURA</div>

        <AuthorizeView Roles="SuperAdmin,Admin">
            <NavLink class="fm-nav-link" href="hierarchy">
                <svg class="fm-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4" />
                    <path d="M9 9v.01M9 12v.01M9 15v.01M9 18v.01" />
                </svg>
                <span>Edificios y Baños</span>
            </NavLink>
        </AuthorizeView>

        <NavLink class="fm-nav-link" href="topology">
            <svg class="fm-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
            </svg>
            <span>Editor de Topología</span>
        </NavLink>

        <div class="fm-nav-section">ACCESO USUARIO</div>

        <NavLink class="fm-nav-link" href="report">
            <svg class="fm-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <path d="M14 14h3v3h-3zM17 17h4v4h-4zM14 20h3" />
            </svg>
            <span>Portal de Reporte QR</span>
        </NavLink>
    </nav>

    <div class="fm-nav-footer">
        <AuthorizeView>
            <Authorized>
                <button class="fm-logout-btn" @onclick="Logout">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    <span>Cerrar Sesión</span>
                </button>
            </Authorized>
            <NotAuthorized>
                <NavLink class="fm-nav-link" href="login">
                    <svg class="fm-nav-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10 17 15 12 10 7" />
                        <line x1="15" y1="12" x2="3" y2="12" />
                    </svg>
                    <span>Iniciar Sesión</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    [Inject] private AuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse-mobile" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("login");
    }
}
