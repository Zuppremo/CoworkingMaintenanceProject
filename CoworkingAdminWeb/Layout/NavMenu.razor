            <NavLink class="nav-link" href="topology">
                <span class="bi bi-grid-3x3-gap-fill-nav-menu" aria-hidden="true"></span> Topología
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="report">
                <span class="bi bi-exclamation-triangle-fill-nav-menu" aria-hidden="true"></span> Reportar Falla (QR)
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

}