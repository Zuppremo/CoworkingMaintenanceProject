@page "/hierarchy"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Coworking.Shared.Models.DTOs.Building
@using Coworking.Shared.Models.DTOs.Rest
@using System.Net.Http.Json
@using QRCoder
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Gestión de Infraestructura</PageTitle>

<div class="container-fluid mt-4">
    <h2>Gestión de Jerarquía (Edificios > Pisos > Baños)</h2>
    <hr />

    <div class="row">
        <!-- Lista de Edificios -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Edificios</h5>
                    <button class="btn btn-sm btn-light" @onclick="() => showNewBuilding = true">+</button>
                </div>
                <div class="card-body p-0">
                    @if (showNewBuilding)
                    {
                        <div class="p-2 border-bottom bg-light">
                            <input @bind="newBuildingName" class="form-control form-control-sm mb-1" placeholder="Nombre (Ej. Norte)" />
                            <div class="d-flex justify-content-end gap-1">
                                <button class="btn btn-sm btn-secondary" @onclick="() => showNewBuilding = false">Cancelar</button>
                                <button class="btn btn-sm btn-success" @onclick="CreateBuilding">Crear</button>
                            </div>
                        </div>
                    }

                    <ul class="list-group list-group-flush">
                        @foreach (var building in buildings)
                        {
                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedBuilding?.Id == building.Id ? "active" : "")"
                                style="cursor: pointer" @onclick="() => SelectBuilding(building)">
                                @building.Name
                                <button class="btn btn-sm btn-danger py-0 px-2" @onclick="() => DeleteBuilding(building.Id)" @onclick:stopPropagation="true">X</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Lista de Pisos -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Pisos @(selectedBuilding != null ? $"({selectedBuilding.Name})" : "")</h5>
                    @if (selectedBuilding != null)
                    {
                        <button class="btn btn-sm btn-light" @onclick="() => showNewFloor = true">+</button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (showNewFloor)
                    {
                        <div class="p-2 border-bottom bg-light">
                            <input type="number" @bind="newFloorNumber" class="form-control form-control-sm mb-1" placeholder="Nivel (Ej. 1)" />
                            <div class="d-flex justify-content-end gap-1">
                                <button class="btn btn-sm btn-secondary" @onclick="() => showNewFloor = false">Cancelar</button>
                                <button class="btn btn-sm btn-success" @onclick="CreateFloor">Crear</button>
                            </div>
                        </div>
                    }

                    @if (selectedBuilding != null)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var floor in selectedBuilding.Floors)
                            {
                                <li class="list-group-item list-group-item-action @(selectedFloor?.Id == floor.Id ? "active" : "")"
                                    style="cursor: pointer" @onclick="() => SelectFloor(floor)">
                                    Piso @floor.FloorNumber
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-3 text-muted text-center">Seleccione un Edificio</div>
                    }
                </div>
            </div>
        </div>

        <!-- Lista de Baños -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Baños @(selectedFloor != null ? $"(Piso {selectedFloor.FloorNumber})" : "")</h5>
                    @if (selectedFloor != null)
                    {
                        <button class="btn btn-sm btn-light" @onclick="() => showNewRestroom = true">+</button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (showNewRestroom)
                    {
                        <div class="p-2 border-bottom bg-light">
                            <input @bind="newRestroomIdentifier" class="form-control form-control-sm mb-1" placeholder="Ej. Hombres Sur" />
                            <div class="d-flex justify-content-end gap-1">
                                <button class="btn btn-sm btn-secondary" @onclick="() => showNewRestroom = false">Cancelar</button>
                                <button class="btn btn-sm btn-success" @onclick="CreateRestroom">Crear</button>
                            </div>
                        </div>
                    }

                    @if (selectedFloor != null)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var restroom in selectedFloor.Restrooms)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @restroom.Identifier
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowQr(restroom)">
                                        🔲 QR
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-3 text-muted text-center">Seleccione un Piso</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (selectedRestroomForQr != null && qrCodeImageBase64 != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Código QR - @selectedRestroomForQr.Identifier</h5>
                    <button type="button" class="btn-close" @onclick="CloseQr"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="text-muted small">Imprime este código y colócalo en la puerta del baño.</p>
                    <img src="data:image/png;base64,@qrCodeImageBase64" alt="Código QR" class="img-fluid" style="max-width: 300px; border: 1px solid #ddd; padding: 10px; border-radius: 10px;" />
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-secondary" @onclick="CloseQr">Cerrar</button>
                    <!-- Truco simple: abrir la imagen en otra pestaña para imprimir -->
                    <a class="btn btn-primary" href="data:image/png;base64,@qrCodeImageBase64" target="_blank" download="QR_Bano_@selectedRestroomForQr.Id">Descargar Imagen</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BuildingDto> buildings = new();
    
    private BuildingDto? selectedBuilding;
    private FloorDto? selectedFloor;

    private bool showNewBuilding = false;
    private string newBuildingName = "";

    private bool showNewFloor = false;
    private int newFloorNumber = 1;

    private bool showNewRestroom = false;
    private string newRestroomIdentifier = "";
    
    private RestroomHierarchyDto? selectedRestroomForQr;
    private string? qrCodeImageBase64;

    private void ShowQr(RestroomHierarchyDto restroom)
    {
        selectedRestroomForQr = restroom;
        string url = Navigation.BaseUri + "report/" + restroom.Id;
        using QRCodeGenerator qrGenerator = new QRCodeGenerator();
        using QRCodeData qrCodeData = qrGenerator.CreateQrCode(url, QRCodeGenerator.ECCLevel.Q);
        using PngByteQRCode qrCode = new PngByteQRCode(qrCodeData);
        byte[] qrCodeImage = qrCode.GetGraphic(20);
        qrCodeImageBase64 = Convert.ToBase64String(qrCodeImage);
    }

    private void CloseQr()
    {
        selectedRestroomForQr = null;
        qrCodeImageBase64 = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadHierarchy();
    }

    private async Task LoadHierarchy()
    {
        buildings = await Http.GetFromJsonAsync<List<BuildingDto>>("api/Hierarchy") ?? new();
        
        // Mantener selección si se refresca
        if (selectedBuilding != null)
        {
            selectedBuilding = buildings.FirstOrDefault(b => b.Id == selectedBuilding.Id);
            if (selectedFloor != null && selectedBuilding != null)
            {
                selectedFloor = selectedBuilding.Floors.FirstOrDefault(f => f.Id == selectedFloor.Id);
            }
        }
    }

    private void SelectBuilding(BuildingDto building)
    {
        selectedBuilding = building;
        selectedFloor = null;
    }

    private void SelectFloor(FloorDto floor)
    {
        selectedFloor = floor;
    }

    private async Task CreateBuilding()
    {
        if (string.IsNullOrWhiteSpace(newBuildingName)) return;
        
        var request = new CreateBuildingRequest { Name = newBuildingName };
        await Http.PostAsJsonAsync("api/Hierarchy/buildings", request);
        
        newBuildingName = "";
        showNewBuilding = false;
        await LoadHierarchy();
    }

    private async Task DeleteBuilding(Guid id)
    {
        await Http.DeleteAsync($"api/Hierarchy/buildings/{id}");
        if (selectedBuilding?.Id == id) selectedBuilding = null;
        await LoadHierarchy();
    }

    private async Task CreateFloor()
    {
        if (selectedBuilding == null) return;
        
        var request = new CreateFloorRequest { FloorNumber = newFloorNumber, BuildingId = selectedBuilding.Id };
        await Http.PostAsJsonAsync("api/Hierarchy/floors", request);
        
        newFloorNumber++;
        showNewFloor = false;
        await LoadHierarchy();
    }

    private async Task CreateRestroom()
    {
        if (selectedFloor == null || string.IsNullOrWhiteSpace(newRestroomIdentifier)) return;
        
        var request = new CreateRestroomRequest { Identifier = newRestroomIdentifier, FloorId = selectedFloor.Id };
        await Http.PostAsJsonAsync("api/Hierarchy/restrooms", request);
        
        newRestroomIdentifier = "";
        showNewRestroom = false;
        await LoadHierarchy();
    }
}
