@page "/hierarchy"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Coworking.Shared.Models.DTOs.Building
@using Coworking.Shared.Models.DTOs.Rest
@using System.Net.Http.Json
@using QRCoder
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Infraestructura | Urban 165</PageTitle>

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="fm-pill fm-pill-slate">JERARQUÍA ESPACIAL</span>
    </div>
    <h1 class="h3 fw-bold mb-1" style="letter-spacing: -0.02em;">Edificios, Pisos y Zonas Sanitarias</h1>
    <p class="text-muted small mb-0">Administra la estructura física y genera códigos QR para el portal de reportes.</p>
</div>

<div class="row g-4">
    <!-- Lista de Edificios -->
    <div class="col-md-4">
        <div class="fm-card overflow-hidden h-100">
            <div class="fm-card-header" style="background: #0F172A; color: #FFFFFF;">
                <h2 class="fm-card-title text-white">Edificios</h2>
                <button class="btn btn-sm" style="background: rgba(20,184,166,0.2); color: #2DD4BF; border: 1px solid rgba(20,184,166,0.35); font-weight: 700;" @onclick="() => showNewBuilding = true">+ Nuevo</button>
            </div>
            <div class="p-0">
                @if (showNewBuilding)
                {
                    <div class="p-3 border-bottom" style="background: #F8FAFC;">
                        <input @bind="newBuildingName" class="fm-input w-100 mb-2" placeholder="Nombre (Ej. Urban 165)" />
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn-fm-outline py-1 px-2" @onclick="() => showNewBuilding = false">Cancelar</button>
                            <button class="btn-fm-accent py-1 px-3" @onclick="CreateBuilding">Crear</button>
                        </div>
                    </div>
                }

                <div class="list-group list-group-flush">
                    @foreach (var building in buildings)
                    {
                        var isSelected = selectedBuilding?.Id == building.Id;
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 px-3"
                             style="cursor: pointer; @(isSelected ? "background: #F0FDFA; border-left: 3px solid #0D9488; color: #0F172A; font-weight: 700;" : "")"
                             @onclick="() => SelectBuilding(building)">
                            <span>@building.Name</span>
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => DeleteBuilding(building.Id)" @onclick:stopPropagation="true">Eliminar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Pisos -->
    <div class="col-md-4">
        <div class="fm-card overflow-hidden h-100">
            <div class="fm-card-header" style="background: #1E293B; color: #FFFFFF;">
                <h2 class="fm-card-title text-white">Pisos @(selectedBuilding != null ? $"• {selectedBuilding.Name}" : "")</h2>
                @if (selectedBuilding != null)
                {
                    <button class="btn btn-sm" style="background: rgba(20,184,166,0.2); color: #2DD4BF; border: 1px solid rgba(20,184,166,0.35); font-weight: 700;" @onclick="() => showNewFloor = true">+ Nuevo</button>
                }
            </div>
            <div class="p-0">
                @if (showNewFloor)
                {
                    <div class="p-3 border-bottom" style="background: #F8FAFC;">
                        <input type="number" @bind="newFloorNumber" class="fm-input w-100 mb-2" placeholder="Nivel (Ej. 1)" />
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn-fm-outline py-1 px-2" @onclick="() => showNewFloor = false">Cancelar</button>
                            <button class="btn-fm-accent py-1 px-3" @onclick="CreateFloor">Crear</button>
                        </div>
                    </div>
                }

                @if (selectedBuilding != null)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var floor in selectedBuilding.Floors)
                        {
                            var isSelected = selectedFloor?.Id == floor.Id;
                            <div class="list-group-item list-group-item-action py-3 px-3"
                                 style="cursor: pointer; @(isSelected ? "background: #F0FDFA; border-left: 3px solid #0D9488; color: #0F172A; font-weight: 700;" : "")"
                                 @onclick="() => SelectFloor(floor)">
                                Piso @floor.FloorNumber
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-muted text-center small">Selecciona un edificio para ver sus pisos.</div>
                }
            </div>
        </div>
    </div>

    <!-- Lista de Baños -->
    <div class="col-md-4">
        <div class="fm-card overflow-hidden h-100">
            <div class="fm-card-header" style="background: #334155; color: #FFFFFF;">
                <h2 class="fm-card-title text-white">Baños @(selectedFloor != null ? $"• Piso {selectedFloor.FloorNumber}" : "")</h2>
                @if (selectedFloor != null)
                {
                    <button class="btn btn-sm" style="background: rgba(20,184,166,0.2); color: #2DD4BF; border: 1px solid rgba(20,184,166,0.35); font-weight: 700;" @onclick="() => showNewRestroom = true">+ Nuevo</button>
                }
            </div>
            <div class="p-0">
                @if (showNewRestroom)
                {
                    <div class="p-3 border-bottom" style="background: #F8FAFC;">
                        <input @bind="newRestroomIdentifier" class="fm-input w-100 mb-2" placeholder="Ej. Hombres Sur" />
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn-fm-outline py-1 px-2" @onclick="() => showNewRestroom = false">Cancelar</button>
                            <button class="btn-fm-accent py-1 px-3" @onclick="CreateRestroom">Crear</button>
                        </div>
                    </div>
                }

                @if (selectedFloor != null)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var restroom in selectedFloor.Restrooms)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                <span class="fw-semibold text-dark">@restroom.Identifier</span>
                                <button class="btn-fm-outline py-1 px-2" @onclick="() => ShowQr(restroom)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="7" height="7" rx="1" />
                                        <rect x="14" y="3" width="7" height="7" rx="1" />
                                        <rect x="3" y="14" width="7" height="7" rx="1" />
                                        <path d="M14 14h7v7h-7z" />
                                    </svg>
                                    <span>Código QR</span>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-muted text-center small">Selecciona un piso para ver sus baños.</div>
                }
            </div>
        </div>
    </div>
</div>

@if (selectedRestroomForQr != null && qrCodeImageBase64 != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Código QR - @selectedRestroomForQr.Identifier</h5>
                    <button type="button" class="btn-close" @onclick="CloseQr"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="text-muted small">Imprime este código y colócalo en la puerta del baño.</p>
                    <img src="data:image/png;base64,@qrCodeImageBase64" alt="Código QR" class="img-fluid" style="max-width: 300px; border: 1px solid #ddd; padding: 10px; border-radius: 10px;" />
                </div>
                <div class="modal-footer justify-content-center">
                    <button class="btn btn-secondary" @onclick="CloseQr">Cerrar</button>
                    <!-- Truco simple: abrir la imagen en otra pestaña para imprimir -->
                    <a class="btn btn-primary" href="data:image/png;base64,@qrCodeImageBase64" target="_blank" download="QR_Bano_@selectedRestroomForQr.Id">Descargar Imagen</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BuildingDto> buildings = new();
    
    private BuildingDto? selectedBuilding;
    private FloorDto? selectedFloor;

    private bool showNewBuilding = false;
    private string newBuildingName = "";

    private bool showNewFloor = false;
    private int newFloorNumber = 1;

    private bool showNewRestroom = false;
    private string newRestroomIdentifier = "";
    
    private RestroomHierarchyDto? selectedRestroomForQr;
    private string? qrCodeImageBase64;

    private void ShowQr(RestroomHierarchyDto restroom)
    {
        selectedRestroomForQr = restroom;
        string url = Navigation.BaseUri + "report/" + restroom.Id;
        using QRCodeGenerator qrGenerator = new QRCodeGenerator();
        using QRCodeData qrCodeData = qrGenerator.CreateQrCode(url, QRCodeGenerator.ECCLevel.Q);
        using PngByteQRCode qrCode = new PngByteQRCode(qrCodeData);
        byte[] qrCodeImage = qrCode.GetGraphic(20);
        qrCodeImageBase64 = Convert.ToBase64String(qrCodeImage);
    }

    private void CloseQr()
    {
        selectedRestroomForQr = null;
        qrCodeImageBase64 = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadHierarchy();
    }

    private async Task LoadHierarchy()
    {
        buildings = await Http.GetFromJsonAsync<List<BuildingDto>>("api/Hierarchy") ?? new();
        
        // Mantener selección si se refresca
        if (selectedBuilding != null)
        {
            selectedBuilding = buildings.FirstOrDefault(b => b.Id == selectedBuilding.Id);
            if (selectedFloor != null && selectedBuilding != null)
            {
                selectedFloor = selectedBuilding.Floors.FirstOrDefault(f => f.Id == selectedFloor.Id);
            }
        }
    }

    private void SelectBuilding(BuildingDto building)
    {
        selectedBuilding = building;
        selectedFloor = null;
    }

    private void SelectFloor(FloorDto floor)
    {
        selectedFloor = floor;
    }

    private async Task CreateBuilding()
    {
        if (string.IsNullOrWhiteSpace(newBuildingName)) return;
        
        var request = new CreateBuildingRequest { Name = newBuildingName };
        await Http.PostAsJsonAsync("api/Hierarchy/buildings", request);
        
        newBuildingName = "";
        showNewBuilding = false;
        await LoadHierarchy();
    }

    private async Task DeleteBuilding(Guid id)
    {
        await Http.DeleteAsync($"api/Hierarchy/buildings/{id}");
        if (selectedBuilding?.Id == id) selectedBuilding = null;
        await LoadHierarchy();
    }

    private async Task CreateFloor()
    {
        if (selectedBuilding == null) return;
        
        var request = new CreateFloorRequest { FloorNumber = newFloorNumber, BuildingId = selectedBuilding.Id };
        await Http.PostAsJsonAsync("api/Hierarchy/floors", request);
        
        newFloorNumber++;
        showNewFloor = false;
        await LoadHierarchy();
    }

    private async Task CreateRestroom()
    {
        if (selectedFloor == null || string.IsNullOrWhiteSpace(newRestroomIdentifier)) return;
        
        var request = new CreateRestroomRequest { Identifier = newRestroomIdentifier, FloorId = selectedFloor.Id };
        await Http.PostAsJsonAsync("api/Hierarchy/restrooms", request);
        
        newRestroomIdentifier = "";
        showNewRestroom = false;
        await LoadHierarchy();
    }
}
