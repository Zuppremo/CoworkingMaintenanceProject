@page "/report"
@page "/report/{RestroomIdParam:guid}"
@using Coworking.Shared.Enums
@using Coworking.Shared.Models.DTOs
@using Coworking.Shared.Models.DTOs.Building
@using Coworking.Shared.Models.DTOs.Telemetry
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Reporte QR | Urban 165</PageTitle>

<div class="container py-4" style="max-width: 560px;">
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-4 mb-3" style="width: 52px; height: 52px; background: #0F172A; color: #14B8A6;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <path d="M14 14h3v3h-3zM17 17h4v4h-4zM14 20h3" />
            </svg>
        </div>
        <div class="text-uppercase fw-bold small mb-1" style="letter-spacing: 0.1em; color: #0D9488;">URBAN 165 • PORTAL QR</div>
        <h1 class="h4 fw-bold text-dark mb-1">Reporte Rápido de Incidencia</h1>
        <p class="text-muted small mb-0">Notificación directa en tiempo real al personal de servicios generales</p>
    </div>

    @if (isSuccess)
    {
        <div class="fm-card text-center p-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 64px; height: 64px; background: #F0FDFA; color: #0D9488; border: 1px solid rgba(13, 148, 136, 0.25);">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>
            <h2 class="h4 fw-bold text-dark mb-2">Reporte Enviado</h2>
            <p class="text-muted small mb-4">
                El equipo de limpieza y mantenimiento ha recibido la alerta en tiempo real en su aplicación móvil.
            </p>
            <button class="btn-fm-outline px-4" @onclick="ResetForm">
                Registrar otro reporte
            </button>
        </div>
    }
    else
    {
        <div class="fm-card p-4">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-secondary mb-3" role="status"></div>
                    <p class="text-muted small mb-0">Cargando plano de activos del baño...</p>
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger border-0 py-2 px-3 small mb-3">
                        @errorMessage
                    </div>
                }

                @if (RestroomIdParam == null)
                {
                    <div class="text-center py-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3" style="width: 56px; height: 56px; background: #F1F5F9; color: #334155;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="3" width="7" height="7" rx="1" />
                                <rect x="14" y="3" width="7" height="7" rx="1" />
                                <rect x="3" y="14" width="7" height="7" rx="1" />
                                <path d="M14 14h7v7h-7z" />
                            </svg>
                        </div>
                        <h2 class="h5 fw-bold text-dark">Se requiere código QR</h2>
                        <p class="text-muted small mb-0">
                            Escanea el código QR ubicado en la entrada o espejo del baño para identificar automáticamente la zona y sus activos.
                        </p>
                    </div>
                }
                else if (currentLayout != null)
                {
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-4" style="background: #F8FAFC; border: 1px solid #E2E8F0;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width: 34px; height: 34px; background: #0F172A; color: #14B8A6;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                            </span>
                            <div>
                                <div class="fw-bold small text-dark">@currentLayout.Identifier</div>
                                <div class="text-muted" style="font-size: 0.74rem;">Ubicación verificada por QR</div>
                            </div>
                        </div>
                        <span class="fm-pill fm-pill-teal">ACTIVO</span>
                    </div>
                }

                @if (currentLayout != null && currentLayout.Assets.Any())
                {
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary text-uppercase" style="letter-spacing: 0.04em;">1. Selecciona el activo afectado</label>
                        <div class="d-grid gap-2">
                            @foreach (var asset in currentLayout.Assets)
                            {
                                var isSelected = selectedAssetId == asset.Id;
                                <button type="button"
                                        class="btn text-start p-3 rounded-3 d-flex align-items-center justify-content-between"
                                        style="@(isSelected ? "background: #0F172A; color: #FFFFFF; border: 1px solid #0F172A;" : "background: #FFFFFF; color: #0F172A; border: 1px solid #CBD5E1;")"
                                        @onclick="() => SelectAsset(asset.Id)">
                                    <span class="d-flex align-items-center gap-3">
                                        <span class="d-inline-flex align-items-center justify-content-center rounded-2"
                                              style="width: 34px; height: 34px; background: @(isSelected ? "rgba(20,184,166,0.2)" : "#F1F5F9"); color: @(isSelected ? "#2DD4BF" : "#334155");">
                                            @GetAssetSvg(asset.Type)
                                        </span>
                                        <span>
                                            <span class="fw-bold d-block small">@GetAssetLabel(asset.Type)</span>
                                            <span class="mono-num" style="font-size: 0.72rem; opacity: 0.75;">Coordenada (@asset.PositionX, @asset.PositionY)</span>
                                        </span>
                                    </span>
                                    @if (isSelected)
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2DD4BF" stroke-width="2.5">
                                            <polyline points="20 6 9 17 4 12" />
                                        </svg>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary text-uppercase" style="letter-spacing: 0.04em;">2. Describe la novedad</label>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var reason in commonReasons)
                            {
                                var isSelected = selectedReason == reason;
                                <button type="button"
                                        class="btn btn-sm rounded-3 px-3 py-2 fw-semibold"
                                        style="@(isSelected ? "background: #0D9488; color: #FFFFFF; border: 1px solid #0D9488;" : "background: #F8FAFC; color: #334155; border: 1px solid #E2E8F0;")"
                                        @onclick="() => SelectReason(reason)">
                                    @reason
                                </button>
                            }
                        </div>

                        <input type="text"
                               class="fm-input w-100"
                               placeholder="O especifica otro detalle aquí..."
                               @bind="customDescription" />
                    </div>

                    <button class="btn-fm-primary w-100 py-3"
                            style="background-color: #DC2626; border-color: #DC2626;"
                            disabled="@(selectedAssetId == null || (string.IsNullOrWhiteSpace(selectedReason) && string.IsNullOrWhiteSpace(customDescription)) || isSubmitting)"
                            @onclick="SubmitReport">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Enviando alerta...</span>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                <line x1="12" y1="9" x2="12" y2="13" />
                                <line x1="12" y1="17" x2="12.01" y2="17" />
                            </svg>
                            <span>Enviar Alerta de Mantenimiento</span>
                        }
                    </button>
                }
                else if (currentLayout != null && !currentLayout.Assets.Any())
                {
                    <div class="alert alert-warning border-0 py-3 small text-center mb-0">
                        Este baño aún no tiene activos configurados en el plano bidimensional.
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid? RestroomIdParam { get; set; }

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string errorMessage = string.Empty;

    private RestroomLayoutDto? currentLayout;
    private Guid? selectedAssetId;
    private string selectedReason = string.Empty;
    private string customDescription = string.Empty;

    private readonly string[] commonReasons = new[]
    {
        "Sin papel higiénico",
        "Sin jabón de manos",
        "Inodoro tapado / averiado",
        "Requiere aseo urgente",
        "Fuga continua de agua",
        "Secador no enciende"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            if (RestroomIdParam.HasValue)
            {
                await LoadRestroomLayoutAsync(RestroomIdParam.Value);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando datos: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadRestroomLayoutAsync(Guid id)
    {
        try
        {
            currentLayout = await Http.GetFromJsonAsync<RestroomLayoutDto>($"api/Topology/{id}");
            selectedAssetId = currentLayout?.Assets.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar el diseño de este baño: {ex.Message}";
        }
    }

    private void SelectAsset(Guid id) => selectedAssetId = id;

    private void SelectReason(string reason)
    {
        selectedReason = reason;
        customDescription = string.Empty;
    }

    private async Task SubmitReport()
    {
        if (!selectedAssetId.HasValue) return;

        var description = !string.IsNullOrWhiteSpace(customDescription)
            ? customDescription
            : selectedReason;

        if (string.IsNullOrWhiteSpace(description)) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            var request = new CreateIssueReportRequest
            {
                RestroomAssetId = selectedAssetId.Value,
                IssueDescription = description,
                ReportingUserId = "coworker-qr-web"
            };

            var response = await Http.PostAsJsonAsync("api/IssueReports", request);
            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var errorObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                errorMessage = errorObj != null && errorObj.TryGetValue("error", out var msg)
                    ? msg
                    : "Este elemento ya tiene un reporte activo pendiente de atención.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"No se pudo enviar el reporte: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de red: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        isSuccess = false;
        selectedReason = string.Empty;
        customDescription = string.Empty;
    }

    private static string GetAssetLabel(AssetType type) => type switch
    {
        AssetType.Toilet => "Inodoro",
        AssetType.Sink => "Lavamanos",
        AssetType.HandDryer => "Secador de manos",
        AssetType.PaperDispenser => "Dispensador de papel",
        _ => "Activo"
    };

    private static MarkupString GetAssetSvg(AssetType type) => type switch
    {
        AssetType.Toilet => new MarkupString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M7 3h10v6H7z\"/><path d=\"M5 9h14v3a7 7 0 0 1-14 0V9z\"/><path d=\"M9 19v2h6v-2\"/></svg>"),
        AssetType.Sink => new MarkupString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3v5\"/><path d=\"M9 3h6\"/><path d=\"M4 10h16v2a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6v-2z\"/><path d=\"M10 18v3h4v-3\"/></svg>"),
        AssetType.PaperDispenser => new MarkupString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M7 16v4h10v-4\"/><line x1=\"7\" y1=\"10\" x2=\"17\" y2=\"10\"/></svg>"),
        AssetType.HandDryer => new MarkupString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"6\" y=\"3\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M9 18v3M12 18v3M15 18v3\"/></svg>"),
        _ => new MarkupString("<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>")
    };
}
