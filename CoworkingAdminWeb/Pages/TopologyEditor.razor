@page "/topology"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Coworking.Shared.Models.DTOs.Rest
@using Coworking.Shared.Models.DTOs.Building
@using CoworkingAdminWeb.Services
@using CoworkingAdminWeb.Components
@inject GridEditorState GridState
@inject HttpClient Http

<PageTitle>Editor de Topología | Urban 165</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="fm-pill fm-pill-slate">GRID SYSTEM 2D</span>
        </div>
        <h1 class="h3 fw-bold mb-1" style="letter-spacing: -0.02em;">Editor de Topología de Baños</h1>
        <p class="text-muted small mb-0">Modelado espacial bidimensional y ubicación de activos por coordenada.</p>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label class="form-label mb-1 small fw-bold text-secondary">Edificio</label>
            <select class="fm-select d-block" @onchange="OnBuildingChanged">
                <option value="">Seleccione...</option>
                @foreach (var b in buildings)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-1 small fw-bold text-secondary">Piso</label>
            <select class="fm-select d-block" @onchange="OnFloorChanged" disabled="@(selectedBuilding == null)">
                <option value="">Seleccione...</option>
                @if (selectedBuilding != null)
                {
                    @foreach (var f in selectedBuilding.Floors)
                    {
                        <option value="@f.Id">Piso @f.FloorNumber</option>
                    }
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-1 small fw-bold text-secondary">Baño</label>
            <select class="fm-select d-block" @onchange="OnRestroomChanged" disabled="@(selectedFloor == null)">
                <option value="">Seleccione...</option>
                @if (selectedFloor != null)
                {
                    @foreach (var r in selectedFloor.Restrooms)
                    {
                        <option value="@r.Id">@r.Identifier</option>
                    }
                }
            </select>
        </div>

        @if (selectedRestroomId.HasValue)
        {
            <div class="d-flex gap-2 align-items-center fm-card px-3 py-2">
                <label class="small fw-bold text-secondary mb-0">Ancho</label>
                <input type="number" class="fm-input mono-num" style="width: 68px; padding: 0.3rem 0.5rem;" @bind="InputWidth" min="5" max="50" />

                <label class="small fw-bold text-secondary mb-0 ms-1">Alto</label>
                <input type="number" class="fm-input mono-num" style="width: 68px; padding: 0.3rem 0.5rem;" @bind="InputHeight" min="5" max="50" />

                <button class="btn-fm-primary py-1 px-3" @onclick="ApplyDimensions">Aplicar</button>
            </div>
        }
    </div>
</div>

@if (selectedRestroomId.HasValue)
{
    <div class="row g-4">
        <div class="col-auto">
            <AssetPalette />

            <div class="mt-3 d-grid gap-2">
                <button class="btn-fm-outline text-danger" @onclick="ClearGrid">Limpiar Lienzo</button>
                <button class="btn-fm-accent" @onclick="SaveTopology" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Plano</span>
                    }
                </button>

                @if (saveSuccess)
                {
                    <div class="fm-pill fm-pill-teal justify-content-center py-2 mt-1" role="alert">
                        Plano guardado correctamente
                    </div>
                }
            </div>
        </div>

        <div class="col fm-card overflow-auto d-flex justify-content-center align-items-start p-4" style="min-height: 600px; background: #F1F5F9;">
            <GridCanvas CellSize="40" />
        </div>
    </div>
}
else
{
    <div class="fm-card p-5 text-center mt-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3" style="width: 52px; height: 52px; background: #F1F5F9; color: #334155;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
            </svg>
        </div>
        <h2 class="h5 fw-bold text-dark mb-1">Selecciona una zona sanitaria</h2>
        <p class="text-muted small mb-0">Elige edificio, piso y baño en la barra superior para abrir el plano interactivo.</p>
    </div>
}

@code {
    private List<BuildingDto> buildings = new();
    private BuildingDto? selectedBuilding;
    private FloorDto? selectedFloor;
    private Guid? selectedRestroomId;

    private int InputWidth = 15;
    private int InputHeight = 15;
    private bool isSaving = false;
    private bool saveSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        InputWidth = GridState.GridWidth;
        InputHeight = GridState.GridHeight;
        GridState.OnStateChanged += StateHasChanged;
        
        buildings = await Http.GetFromJsonAsync<List<BuildingDto>>("api/Hierarchy") ?? new();
    }

    private void OnBuildingChanged(ChangeEventArgs e)
    {
        selectedFloor = null;
        selectedRestroomId = null;
        if (Guid.TryParse(e.Value?.ToString(), out Guid id))
            selectedBuilding = buildings.FirstOrDefault(b => b.Id == id);
        else
            selectedBuilding = null;
    }

    private void OnFloorChanged(ChangeEventArgs e)
    {
        selectedRestroomId = null;
        if (Guid.TryParse(e.Value?.ToString(), out Guid id) && selectedBuilding != null)
            selectedFloor = selectedBuilding.Floors.FirstOrDefault(f => f.Id == id);
        else
            selectedFloor = null;
    }

    private async Task OnRestroomChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid id))
        {
            selectedRestroomId = id;
            await LoadExistingLayout(id);
        }
        else
        {
            selectedRestroomId = null;
            GridState.ClearGrid();
        }
    }

    private async Task LoadExistingLayout(Guid id)
    {
        try
        {
            var layout = await Http.GetFromJsonAsync<RestroomLayoutDto>($"api/Topology/{id}");
            if (layout != null)
            {
                InputWidth = layout.GridWidth > 5 ? layout.GridWidth : 15;
                InputHeight = layout.GridHeight > 5 ? layout.GridHeight : 15;
                GridState.LoadState(InputWidth, InputHeight, layout.Assets);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading layout: {ex.Message}");
            // Probably a 404 (no layout yet), start fresh
            InputWidth = 15;
            InputHeight = 15;
            GridState.LoadState(15, 15, new());
        }
    }

    private void ApplyDimensions()
    {
        if (InputWidth >= 5 && InputHeight >= 5)
        {
            GridState.SetDimensions(InputWidth, InputHeight);
            GridState.ClearGrid(); // Clear grid on resize to prevent out of bounds
        }
    }

    private void ClearGrid()
    {
        GridState.ClearGrid();
        saveSuccess = false;
    }

    private async Task SaveTopology()
    {
        if (!selectedRestroomId.HasValue) return;

        isSaving = true;
        saveSuccess = false;
        
        try
        {
            var request = new Coworking.Shared.Models.DTOs.Rest.SyncRestroomTopologyRequest
            {
                RestroomId = selectedRestroomId.Value,
                GridWidth = (short)GridState.GridWidth,
                GridHeight = (short)GridState.GridHeight,
                Assets = GridState.PlacedAssets.Select(a => new Coworking.Shared.Models.DTOs.Rest.TopologyAssetDto {
                    Id = a.Id,
                    Type = a.Type,
                    PositionX = a.PositionX,
                    PositionY = a.PositionY
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("api/Topology/sync", request);
            
            if (response.IsSuccessStatusCode)
            {
                saveSuccess = true;
            }
            else
            {
                var errorStr = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error guardando topología: {errorStr}");
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    public void Dispose()
    {
        GridState.OnStateChanged -= StateHasChanged;
    }
}
