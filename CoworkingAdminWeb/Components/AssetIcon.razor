@using Coworking.Shared.Enums

<g class="asset-icon" style="pointer-events: none;">
    @switch (Type)
    {
        case AssetType.Toilet:
            <rect width="@(CellSize * 0.8)" height="@(CellSize * 0.8)" x="@(CellSize * 0.1)" y="@(CellSize * 0.1)" rx="4" fill="#3b82f6" stroke="#2563eb" stroke-width="2" />
            <circle cx="@(CellSize * 0.5)" cy="@(CellSize * 0.5)" r="@(CellSize * 0.2)" fill="#ffffff" />
            break;
            
        case AssetType.Sink:
            <ellipse cx="@(CellSize * 0.5)" cy="@(CellSize * 0.5)" rx="@(CellSize * 0.4)" ry="@(CellSize * 0.3)" fill="#10b981" stroke="#059669" stroke-width="2" />
            <circle cx="@(CellSize * 0.5)" cy="@(CellSize * 0.5)" r="@(CellSize * 0.1)" fill="#d1fae5" />
            break;
            
        case AssetType.PaperDispenser:
            <rect width="@(CellSize * 0.6)" height="@(CellSize * 0.4)" x="@(CellSize * 0.2)" y="@(CellSize * 0.3)" rx="2" fill="#8b5cf6" stroke="#7c3aed" stroke-width="2" />
            <line x1="@(CellSize * 0.2)" y1="@(CellSize * 0.5)" x2="@(CellSize * 0.8)" y2="@(CellSize * 0.5)" stroke="#ffffff" stroke-width="2" stroke-dasharray="2 2" />
            break;
            
        case AssetType.HandDryer:
            <rect width="@(CellSize * 0.5)" height="@(CellSize * 0.7)" x="@(CellSize * 0.25)" y="@(CellSize * 0.15)" rx="3" fill="#f59e0b" stroke="#d97706" stroke-width="2" />
            <path d="M @(CellSize * 0.3) @(CellSize * 0.8) Q @(CellSize * 0.5) @(CellSize * 1.0) @(CellSize * 0.7) @(CellSize * 0.8)" fill="none" stroke="#fef3c7" stroke-width="2" />
            break;
    }
</g>

@code {
    [Parameter, EditorRequired]
    public AssetType Type { get; set; }

    [Parameter]
    public int CellSize { get; set; } = 40;
}
