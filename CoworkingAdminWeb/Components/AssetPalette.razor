@using Coworking.Shared.Enums
@inject CoworkingAdminWeb.Services.GridEditorState GridState

<div class="fm-card p-3" style="width: 240px;">
    <div class="text-uppercase fw-bold small text-secondary mb-3" style="letter-spacing: 0.05em;">Activos (Arrastrar)</div>
    <div class="d-flex flex-column gap-2">
        @foreach (AssetType type in Enum.GetValues(typeof(AssetType)))
        {
            <div class="d-flex align-items-center gap-2 p-2 rounded-3 border bg-white"
                 draggable="true"
                 @ondragstart="() => OnDragStart(type)"
                 style="cursor: grab; border-color: #E2E8F0 !important;">
                <svg width="36" height="36" class="flex-shrink-0">
                    <AssetIcon Type="@type" CellSize="36" />
                </svg>
                <span class="fw-semibold small text-dark">@GetAssetLabel(type)</span>
            </div>
        }
    </div>
</div>

@code {
    private void OnDragStart(AssetType type)
    {
        GridState.StartDrag(type);
    }

    private static string GetAssetLabel(AssetType type) => type switch
    {
        AssetType.Toilet => "Inodoro",
        AssetType.Sink => "Lavamanos",
        AssetType.PaperDispenser => "Dispensador Papel",
        AssetType.HandDryer => "Secador Manos",
        _ => type.ToString()
    };
}
