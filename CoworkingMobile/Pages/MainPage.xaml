<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoworkingMobile.ViewModels"
             xmlns:pages="clr-namespace:CoworkingMobile.Pages"
             xmlns:fonts="clr-namespace:Fonts"
             x:Name="DashboardPage"
             x:Class="CoworkingMobile.Pages.MainPage"
             x:DataType="vm:CleaningDashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Architectural Dark Header -->
        <Border Grid.Row="0"
                BackgroundColor="#0F172A"
                Padding="18,16,18,18"
                StrokeShape="RoundRectangle 0,0,22,22"
                StrokeThickness="0">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#1E293B"
                            Stroke="#14B8A6"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10">
                        <Label Text="{x:Static fonts:FluentUI.broom_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="20"
                               TextColor="#14B8A6"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="URBAN 165  •  CAMPO"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="1.2"
                               TextColor="#2DD4BF" />
                        <Label Text="Panel Operativo"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2"
                            BackgroundColor="#1E293B"
                            Stroke="#334155"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            WidthRequest="40"
                            HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static fonts:FluentUI.sign_out_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="18"
                               TextColor="#CBD5E1"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- SignalR Live Telemetry Pill -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            BackgroundColor="{Binding ConnectionBadgeBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 99"
                            Padding="10,5">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Ellipse WidthRequest="7"
                                     HeightRequest="7"
                                     Fill="{Binding ConnectionColor}"
                                     VerticalOptions="Center" />
                            <Label Text="{Binding ConnectionStatusText}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding ConnectionColor}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label Grid.Column="1"
                           Text="{Binding ActiveCount, StringFormat='{0} activas en turno'}"
                           FontSize="12"
                           TextColor="#94A3B8"
                           HorizontalOptions="End"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Operational Counters Strip -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="10" Padding="16,14,16,4">
            <Border Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                    <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" BackgroundColor="#FEF2F2" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Label Text="{x:Static fonts:FluentUI.warning_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="16"
                               TextColor="#DC2626"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding PendingCount}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Pendientes" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                    <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" BackgroundColor="#FFFBEB" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                        <Label Text="{x:Static fonts:FluentUI.clock_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="16"
                               TextColor="#D97706"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding InProgressCount}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="En Atención" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Issues Feed with Pull-to-Refresh -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadIssuesCommand}"
                     RefreshColor="#0D9488">

            <ScrollView Padding="16,10,16,24">
                <VerticalStackLayout Spacing="12">

                    <!-- Empty State -->
                    <Border IsVisible="{Binding HasNoIssues}"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 18"
                            Padding="28,36"
                            Margin="0,24,0,0"
                            Stroke="#E2E8F0"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Border WidthRequest="64"
                                    HeightRequest="64"
                                    HorizontalOptions="Center"
                                    BackgroundColor="#F0FDFA"
                                    Stroke="#99F6E4"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 32">
                                <Label Text="{x:Static fonts:FluentUI.shield_checkmark_48_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="32"
                                       TextColor="#0D9488"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Instalaciones al día"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalOptions="Center" />
                            <Label Text="No hay incidencias sanitarias pendientes en este momento. Desliza hacia abajo para actualizar."
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Issue Cards -->
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding ActiveIssues}">
                        <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueItemViewModel">
                            <Border BackgroundColor="White"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="0">
                                <Grid ColumnDefinitions="5, *">
                                    <!-- Left Status Accent Bar -->
                                    <BoxView Grid.Column="0"
                                             Color="{Binding StatusBadgeColor}"
                                             VerticalOptions="Fill" />

                                    <VerticalStackLayout Grid.Column="1" Padding="14" Spacing="12">
                                        <!-- Top Location & Status Pill -->
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                                <Label Text="{x:Static fonts:FluentUI.location_24_regular}"
                                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                       FontSize="14"
                                                       TextColor="#64748B"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding LocationText}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#475569"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding StatusSoftBgColor}"
                                                    Stroke="{Binding StatusBadgeColor}"
                                                    StrokeThickness="1"
                                                    Padding="8,3"
                                                    StrokeShape="RoundRectangle 99">
                                                <Label Text="{Binding StatusBadgeText}"
                                                       TextColor="{Binding StatusBadgeColor}"
                                                       FontSize="10"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                                        <!-- Asset Icon + Issue Details -->
                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    BackgroundColor="#F1F5F9"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding AssetIconGlyph}"
                                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                       FontSize="22"
                                                       TextColor="#0F172A"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding IssueDescription}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A" />

                                                <HorizontalStackLayout Spacing="8">
                                                    <Label Text="{Binding AssetName}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#0D9488" />
                                                    <Label Text="•" FontSize="12" TextColor="#CBD5E1" />
                                                    <Label Text="{Binding CoordinatesText}"
                                                           FontSize="12"
                                                           TextColor="#64748B" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                                                    <Label Text="{x:Static fonts:FluentUI.clock_24_regular}"
                                                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                           FontSize="12"
                                                           TextColor="#94A3B8"
                                                           VerticalOptions="Center" />
                                                    <Label Text="{Binding ElapsedTimeText}"
                                                           FontSize="11"
                                                           TextColor="#94A3B8"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Action Buttons -->
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,2,0,0">
                                            <Button Grid.Column="0"
                                                    Text="En camino"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="#F8FAFC"
                                                    TextColor="#0F172A"
                                                    BorderColor="#CBD5E1"
                                                    BorderWidth="1"
                                                    HeightRequest="42"
                                                    CornerRadius="10"
                                                    IsVisible="{Binding CanAttend}"
                                                    Command="{Binding Source={x:Reference DashboardPage}, Path=ViewModel.AttendIssueCommand, x:DataType=pages:MainPage}"
                                                    CommandParameter="{Binding .}" />

                                            <Button Grid.Column="1"
                                                    Text="Marcar Resuelto"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="#0D9488"
                                                    TextColor="White"
                                                    HeightRequest="42"
                                                    CornerRadius="10"
                                                    Command="{Binding Source={x:Reference DashboardPage}, Path=ViewModel.ResolveIssueCommand, x:DataType=pages:MainPage}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>
