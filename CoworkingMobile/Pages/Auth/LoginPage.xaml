<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CoworkingMobile.ViewModels.Auth"
             x:DataType="viewmodels:LoginViewModel"
             x:Class="CoworkingMobile.Pages.Auth.LoginPage"
             Title="Login">
             
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,50" VerticalOptions="Center">
            
            <Label Text="👷‍♂️" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Coworking Maintenance" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Inicia sesión para recibir alertas de aseo" FontSize="14" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,20"/>

            <Entry Placeholder="Correo Electrónico"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   ClearButtonVisibility="WhileEditing" />

            <Entry Placeholder="Contraseña"
                   Text="{Binding Password}"
                   IsPassword="True"
                   ClearButtonVisibility="WhileEditing" />

            <Button Text="Ingresar"
                    Command="{Binding LoginCommand}"
                    
                    Margin="0,20,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
